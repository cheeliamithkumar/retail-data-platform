# Copy this file to .env and fill in your own values.
# .env is git-ignored - never commit real credentials.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=etl_user
DB_PASSWORD=change_me
DB_NAME=retail_dw
# Integration tests DROP and recreate this database - it must end in _test
DB_TEST_NAME=retail_dw_test

LOG_LEVEL=INFO
# Rows per chunk when streaming CSV files (lower = less memory)
INGEST_CHUNK_SIZE=5000
